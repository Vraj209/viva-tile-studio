
SITE_URL=http://127.0.0.1:3000

# Configure EXACTLY ONE adapter: Neon, HTTPS webhook, or private filesystem.
# DATABASE_URL selects Neon. When using it, leave both legacy adapter URLs/paths
# empty. Invalid database or conflicting adapter settings prevent submissions.

# Option A: Neon Postgres, with optional private object storage on the SAME branch.
# Pooled postgres:// or postgresql:// URL for server application traffic.
# Use the same database in the public deployment and the owner dashboard.
DATABASE_URL=
# Direct connection for npm run db:migrate; a -pooler host is rejected.
# The migration command loads .env.local. Migrate the intended deployment target.
DATABASE_URL_UNPOOLED=
# Optional attachment storage. Missing/invalid storage disables uploads only;
# enquiries without a file can still be saved to the database.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# HTTPS S3 endpoint for the same Neon branch as DATABASE_URL.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Optional; defaults to viva-tile-studio. Keep the bucket private.
ENQUIRY_STORAGE_BUCKET=viva-tile-studio
# Configure these server-only secrets on the app host too; none are browser vars.

# Neon owner notifications: configure on the PUBLIC WEBSITE server only.
# Apply npm run db:migrate before deploying code that accepts new inquiries.
# Resend API key with email-sending access. Never prefix any secret NEXT_PUBLIC_.
RESEND_API_KEY=
# Owner mailbox; use one bare email address, with no display name or address list.
ENQUIRY_NOTIFICATION_TO=info@vavitilestudio.com
# A sender mailbox on a domain verified in Resend, for example notifications@your-domain.
# Use one bare email address; the server adds the VAVI Tile Studio display name.
ENQUIRY_NOTIFICATION_FROM=
# Optional IANA timezone for the submission timestamp, including its UTC offset.
ENQUIRY_NOTIFICATION_TIMEZONE=America/Toronto
# At least 32 random characters. Authenticates the hosted notification retry route.
# Configure your scheduler every five minutes; see docs/enquiry-notifications.md.
CRON_SECRET=

# Option B: approved HTTPS receiver that persists/accepts a lead before 2xx.
# Leave DATABASE_URL and ENQUIRY_STORAGE_DIR empty.
# Example only: https://your-approved-receiver.example/enquiries
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=

# Option C: explicit absolute PRIVATE persistent directory, never public/.
# Leave DATABASE_URL and ENQUIRY_WEBHOOK_URL empty.
# This stores records without sending notifications. Arrange staff review.
# Windows example: C:/private/vavi-enquiries
# Linux example: /var/lib/vavi/enquiries
ENQUIRY_STORAGE_DIR=

# Exact public scheme and host for reverse-proxy deployments.
# Blank uses the incoming request URL's origin; appropriate for local dev.
# Example only: https://your-approved-domain.example
ENQUIRY_ALLOWED_ORIGIN=

# Enable only if your trusted ingress overwrites/sanitizes X-Forwarded-For.
# This limiter is per-process; use shared throttling for multiple instances.
ENQUIRY_TRUST_PROXY=false
